{
  "name": "formguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-focused local draft recovery for Chromium forms.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
